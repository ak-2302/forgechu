{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "gimon-notes",
    "main": "./worker/index.ts",
    "compatibility_date": "2026-09-16",
    "assets": {
        "not_found_handling": "single-page-application",
        "run_worker_first": [
            "/api/*"
        ]
    },
    "triggers": {
        "crons": ["* * * * *"]
    },
    "d1_databases": [{
        "binding": "DB",
        "database_name": "gimon-notes-db",
        // ローカルD1専用の仮ID。本番デプロイ時は実際のdatabase_idに置き換える。
        "database_id": "0000000-0000-0000-0000-000000000000"
    }],
}
